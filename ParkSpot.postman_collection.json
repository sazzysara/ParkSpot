{
	"info": {
		"_postman_id": "parkspot-api-collection",
		"name": "ParkSpot - Society Visitor Parking Slot Tracker",
		"description": "Collection for testing all ParkSpot backend endpoints including normal flows and edge cases.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Dashboard & Status",
			"item": [
				{
					"name": "Get Dashboard Summary",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/parking/dashboard",
							"host": ["{{baseUrl}}"],
							"path": ["api", "parking", "dashboard"]
						}
					}
				},
				{
					"name": "Get All Slots",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/parking/slots",
							"host": ["{{baseUrl}}"],
							"path": ["api", "parking", "slots"]
						}
					}
				},
				{
					"name": "Get Occupied Slots",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/parking/slots/occupied",
							"host": ["{{baseUrl}}"],
							"path": ["api", "parking", "slots", "occupied"]
						}
					}
				},
				{
					"name": "Get Available Slots",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/parking/slots/available",
							"host": ["{{baseUrl}}"],
							"path": ["api", "parking", "slots", "available"]
						}
					}
				}
			]
		},
		{
			"name": "2. Visitor Vehicle Entry",
			"item": [
				{
					"name": "Log Vehicle Entry (Slot 1)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"vehicleNumber\": \"KA-01-AB-1234\",\n  \"visitorName\": \"John Doe\",\n  \"flatNumber\": \"A-101\",\n  \"slotNumber\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/parking/entry",
							"host": ["{{baseUrl}}"],
							"path": ["api", "parking", "entry"]
						}
					}
				},
				{
					"name": "Log Vehicle Entry (Slot 2)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"vehicleNumber\": \"MH-12-DE-5678\",\n  \"visitorName\": \"Priya Sharma\",\n  \"flatNumber\": \"B-201\",\n  \"slotNumber\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/parking/entry",
							"host": ["{{baseUrl}}"],
							"path": ["api", "parking", "entry"]
						}
					}
				},
				{
					"name": "Edge Case: Assign Already Occupied Slot (Fails 409)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"vehicleNumber\": \"DL-08-CC-9999\",\n  \"visitorName\": \"Second Driver\",\n  \"flatNumber\": \"A-102\",\n  \"slotNumber\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/parking/entry",
							"host": ["{{baseUrl}}"],
							"path": ["api", "parking", "entry"]
						}
					}
				},
				{
					"name": "Edge Case: Invalid Flat (Fails 404)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"vehicleNumber\": \"DL-08-CC-9999\",\n  \"visitorName\": \"Driver\",\n  \"flatNumber\": \"Z-999\",\n  \"slotNumber\": 3\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/parking/entry",
							"host": ["{{baseUrl}}"],
							"path": ["api", "parking", "entry"]
						}
					}
				}
			]
		},
		{
			"name": "3. Visitor Vehicle Exit",
			"item": [
				{
					"name": "Mark Exit and Free Slot (Vehicle ID 1)",
					"request": {
						"method": "PUT",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/parking/exit/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "parking", "exit", "1"]
						}
					}
				},
				{
					"name": "Edge Case: Duplicate Exit Call (Fails 400)",
					"request": {
						"method": "PUT",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/parking/exit/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "parking", "exit", "1"]
						}
					}
				}
			]
		},
		{
			"name": "4. Reports & Search",
			"item": [
				{
					"name": "Daily Visitor Log Report",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/parking/report/daily",
							"host": ["{{baseUrl}}"],
							"path": ["api", "parking", "report", "daily"]
						}
					}
				},
				{
					"name": "Search by Vehicle Number",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/parking/search?vehicleNumber=KA-01",
							"host": ["{{baseUrl}}"],
							"path": ["api", "parking", "search"],
							"query": [
								{
									"key": "vehicleNumber",
									"value": "KA-01"
								}
							]
						}
					}
				},
				{
					"name": "Filter by Flat",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/parking/by-flat/A-101",
							"host": ["{{baseUrl}}"],
							"path": ["api", "parking", "by-flat", "A-101"]
						}
					}
				}
			]
		},
		{
			"name": "5. Flats Management",
			"item": [
				{
					"name": "List All Flats",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/flats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "flats"]
						}
					}
				},
				{
					"name": "Register New Flat",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"flatNumber\": \"D-401\",\n  \"ownerName\": \"Sunil Sharma\",\n  \"contactNumber\": \"9812345678\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/flats",
							"host": ["{{baseUrl}}"],
							"path": ["api", "flats"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		}
	]
}
